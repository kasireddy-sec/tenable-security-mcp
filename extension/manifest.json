{
  "manifest_version": "0.4",
  "name": "tenable-security-mcp",
  "display_name": "Tenable Security MCP",
  "version": "1.0.0",
  "description": "Unified MCP server for Claude Desktop that connects to Nessus and Tenable Vulnerability Management.",
  "author": {
    "name": "Thanuj"
  },
  "server": {
    "type": "uv",
    "entry_point": "src/server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "src/server.py"
      ],
      "env": {
        "NESSUS_URL": "${user_config.nessus_url}",
        "NESSUS_ACCESS_KEY": "${user_config.nessus_access_key}",
        "NESSUS_SECRET_KEY": "${user_config.nessus_secret_key}",
        "UV_PROJECT_ENVIRONMENT": "${HOME}/.tenable-security-mcp-venv"
      }
    }
  },
  "user_config": {
    "nessus_url": {
      "type": "string",
      "title": "Nessus Server URL",
      "description": "Nessus server URL, for example https://localhost:8834",
      "default": "https://localhost:8834",
      "required": true
    },
    "nessus_access_key": {
      "type": "string",
      "title": "Nessus Access Key",
      "description": "Nessus REST API access key.",
      "required": true,
      "sensitive": true
    },
    "nessus_secret_key": {
      "type": "string",
      "title": "Nessus Secret Key",
      "description": "Nessus REST API secret key.",
      "required": true,
      "sensitive": true
    }
  }
}
